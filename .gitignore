# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local font files (used for OG image generation only)
scripts/fonts/

# session handoff — personal work state, not for commit
.claude/session-handoff.md
design-reference/

# copyright: 정본 원고(.md)·신청정보·export 스크립트만 커밋. 파생 PDF·편집용 마커는 제외(재생성 가능)
copyright/*.pdf
copyright/*편집용.md
